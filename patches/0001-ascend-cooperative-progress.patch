+bool AscendDirectTransport::acquireInflight() {
+    const auto deadline =
+        std::chrono::steady_clock::now() +
+        std::chrono::milliseconds(options_.transfer_timeout_ms);
+    for (;;) {
+        {
+            std::lock_guard<std::mutex> lock(inflight_mu_);
+            if (inflight_.load(std::memory_order_acquire) < kMaxInflightReqs) {
+                inflight_.fetch_add(1, std::memory_order_acq_rel);
+                return true;
+            }
+        }
+        // A single submitter may also be the only consumer. Waiting solely
+        // for getTransferStatus() here prevents it from ever reaching poll.
+        progressPending();
+        std::unique_lock<std::mutex> lock(inflight_mu_);
+        if (inflight_.load(std::memory_order_acquire) < kMaxInflightReqs) {
+            continue;
+        }
+        if (std::chrono::steady_clock::now() >= deadline) {
+            return false;
+        }
+        inflight_cv_.wait_for(lock, std::chrono::milliseconds(1));
+    }
+}
+
+void AscendDirectTransport::progressPending() {
+    std::lock_guard<std::mutex> progress_lock(progress_mutex_);
+    std::vector<uint64_t> pending;
+    {
+        std::lock_guard<std::mutex> lock(req_mutex_);
+        pending.assign(pending_groups_.begin(), pending_groups_.end());
+    }
+    for (auto id : pending) {
+        progressGroup(id);
+    }
+}
+
+void AscendDirectTransport::completeGroup(uint64_t group_id,
+                                          TransferStatusEnum status) {
+    bool release = false;
+    void* local_handle = nullptr;
+    size_t local_engine = 0;
+    {
+        std::lock_guard<std::mutex> lock(req_mutex_);
+        auto it = groups_.find(group_id);
+        if (it == groups_.end() ||
+            it->second.status != TransferStatusEnum::PENDING) {
+            return;
+        }
+        it->second.status = status;
+        release = it->second.counted;
+        it->second.counted = false;
+        pending_groups_.erase(group_id);
+        if (it->second.local_copy) {
+            local_handle = it->second.req_handle;
+            local_engine = it->second.engine_idx;
+            it->second.req_handle = nullptr;
+        }
+    }
+    if (local_handle != nullptr) {
+        local_copies_[local_engine]->release(local_handle);
+    }
+    // Completion releases admission independently of how many tasks in the
+    // group have been observed by the caller. Keep their result until then.
+    if (release) {
+        releaseInflight();
+    }
+}
+
+void AscendDirectTransport::progressGroup(uint64_t group_id) {
+    GroupState group;
+    {
+        std::lock_guard<std::mutex> lock(req_mutex_);
+        auto it = groups_.find(group_id);
+        if (it == groups_.end() ||
+            it->second.status != TransferStatusEnum::PENDING) {
+            return;
+        }
+        group = it->second;
+    }
+    TransferStatusEnum mapped = TransferStatusEnum::FAILED;
+    if (group.local_copy) {
+        if (group.engine_idx < local_copies_.size() &&
+            local_copies_[group.engine_idx]) {
+            mapped = local_copies_[group.engine_idx]->poll(group.req_handle);
+        }
+    } else if (group.engine_idx < engines_.size() &&
+               engines_[group.engine_idx]) {
+        HixlXferState state = HixlXferState::Waiting;
+        auto err = engines_[group.engine_idx]->getTransferStatus(
+            group.req_handle, state);
+        mapped = err.ok() ? FromHixlState(state) : TransferStatusEnum::FAILED;
+    }
+    // Observe actual completion before enforcing the software deadline:
+    // delayed application polling must not turn completed DMA into timeout.
+    const auto now = getCurrentTimeInNano();
+    if (mapped == TransferStatusEnum::PENDING && now >= 0 &&
+        group.start_time_ns >= 0 &&
+        now - group.start_time_ns > transfer_timeout_ns_) {
+        mapped = TransferStatusEnum::TIMEOUT;
+    }
+    if (mapped == TransferStatusEnum::PENDING) {
+        return;
+    }
+    if (mapped == TransferStatusEnum::COMPLETED) {
+        completeGroup(group_id, mapped);
+    } else if (group.local_copy) {
+        failLocalCopyStream(group.engine_idx, mapped);
+    } else {
+        failEntireRoute(group.engine_idx, group.remote, mapped,
+                        mapped == TransferStatusEnum::TIMEOUT);
+    }
+}
