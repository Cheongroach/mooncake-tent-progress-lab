+TEST_F(AscendDirectTransportTest, ConcurrentSaturatedSubmitters) {
+    state_->submit_delay_ms = 0;
+    auto conf = std::make_shared<Config>();
+    conf->set("transports/ascend_direct/transfer_timeout_ms", 1000);
+    ASSERT_TRUE(InstallAgentTwoEngines(conf).ok());
+    PublishEngineBuffers();
+    std::vector<std::thread> threads;
+    std::atomic<int> failures{0};
+    for (int worker = 0; worker < 8; ++worker) {
+        threads.emplace_back([&] {
+            Transport::SubBatchRef batch = nullptr;
+            if (!transport_->allocateSubBatch(batch, 256).ok()) {
+                ++failures;
+                return;
+            }
+            char src[16]{};
+            for (int i = 0; i < 256; ++i) {
+                if (!transport_
+                         ->submitTransferTasks(batch,
+                                               {MakeRemoteWrite(src, 16)})
+                         .ok()) {
+                    ++failures;
+                }
+            }
+            for (int i = 255; i >= 0; --i) {
+                TransferStatus status{};
+                if (!transport_->getTransferStatus(batch, i, status).ok() ||
+                    status.s != TransferStatusEnum::COMPLETED ||
+                    status.transferred_bytes != 16) {
+                    ++failures;
+                }
+            }
+            (void)transport_->freeSubBatch(batch);
+        });
+    }
+    for (auto& thread : threads) {
+        thread.join();
+    }
+    EXPECT_EQ(failures.load(), 0);
+    EXPECT_EQ(state_->transfer_async_calls, 2048);
+    EXPECT_EQ(state_->get_status_calls, 2048);
+    EXPECT_EQ(AscendDirectTransportTestPeer::inflight(*transport_), 0);
+}
